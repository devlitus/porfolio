---

---

<section
  class="w-full max-w-[1280px] px-4 md:px-10 py-16 md:py-24 mx-auto"
  id="services"
>
  <div class="text-center max-w-2xl mx-auto mb-16">
    <h2 class="text-3xl font-bold tracking-tight mb-4">Services</h2>
    <p class="text-gray-600 dark:text-gray-400">
      Tailored development solutions to help your business grow.
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Service 1 -->
    <div
      class="bg-white dark:bg-surface-dark p-8 rounded-2xl border border-gray-200 dark:border-gray-800 hover:border-primary/50 transition-all hover:shadow-lg dark:hover:shadow-primary/5"
    >
      <div
        class="size-12 rounded-lg bg-blue-100 dark:bg-blue-900/20 text-primary flex items-center justify-center mb-6"
      >
        <span class="material-symbols-outlined">code</span>
      </div>
      <h3 class="text-xl font-bold mb-3">Frontend Development</h3>
      <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
        Responsive, interactive user interfaces built with modern frameworks.
      </p>
      <ul class="space-y-3 mb-8">
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > React / Vue.js
        </li>
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > Responsive Design
        </li>
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > Performance Optimization
        </li>
      </ul>
    </div>
    <!-- Service 2 -->
    <div
      class="bg-white dark:bg-surface-dark p-8 rounded-2xl border border-primary ring-1 ring-primary/20 relative"
    >
      <div
        class="absolute top-0 right-0 bg-primary text-white text-xs font-bold px-3 py-1 rounded-bl-lg rounded-tr-lg"
      >
        POPULAR
      </div>
      <div
        class="size-12 rounded-lg bg-blue-100 dark:bg-blue-900/20 text-primary flex items-center justify-center mb-6"
      >
        <span class="material-symbols-outlined">layers</span>
      </div>
      <h3 class="text-xl font-bold mb-3">Full Stack MVP</h3>
      <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
        Complete product development from idea to launch.
      </p>
      <ul class="space-y-3 mb-8">
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > Database Design
        </li>
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > API Development
        </li>
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > Authentication & Security
        </li>
      </ul>
    </div>
    <!-- Service 3 -->
    <div
      class="bg-white dark:bg-surface-dark p-8 rounded-2xl border border-gray-200 dark:border-gray-800 hover:border-primary/50 transition-all hover:shadow-lg dark:hover:shadow-primary/5"
    >
      <div
        class="size-12 rounded-lg bg-blue-100 dark:bg-blue-900/20 text-primary flex items-center justify-center mb-6"
      >
        <span class="material-symbols-outlined">dns</span>
      </div>
      <h3 class="text-xl font-bold mb-3">Backend Architecture</h3>
      <p class="text-gray-600 dark:text-gray-400 text-sm mb-6">
        Scalable server-side logic and database management.
      </p>
      <ul class="space-y-3 mb-8">
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > Node.js / Python
        </li>
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > Cloud Infrastructure (AWS)
        </li>
        <li
          class="flex items-center gap-3 text-sm text-gray-700 dark:text-gray-300"
        >
          <span class="material-symbols-outlined text-green-500 text-lg"
            >check</span
          > Microservices
        </li>
      </ul>
    </div>
  </div>
</section>
