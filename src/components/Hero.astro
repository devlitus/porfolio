<section
  class="w-full max-w-[1280px] px-4 md:px-10 py-12 md:py-20 flex flex-col justify-center mx-auto"
>
  <div class="flex flex-col-reverse lg:flex-row items-center gap-12">
    <div class="flex flex-col gap-6 lg:w-1/2">
      <div class="flex flex-col gap-4 text-left">
        <span class="text-primary font-bold tracking-wider uppercase text-sm"
          >Full Stack Developer</span
        >
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight"
        >
          Building digital <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-400"
            >experiences</span
          > that matter
        </h1>
        <p
          class="text-gray-600 dark:text-gray-400 text-lg md:text-xl leading-relaxed max-w-lg"
        >
          Hi, I'm Alex. I specialize in modern web technologies, creating
          pixel-perfect, performant, and accessible applications.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 pt-2">
        <a
          class="flex cursor-pointer items-center justify-center rounded-lg h-12 px-8 bg-primary text-white text-base font-bold transition-all hover:bg-blue-700 hover:shadow-lg hover:shadow-primary/30"
          href="#projects"
        >
          View Work
        </a>
        <a
          class="flex cursor-pointer items-center justify-center rounded-lg h-12 px-8 border border-gray-300 dark:border-gray-700 hover:border-primary dark:hover:border-primary text-gray-800 dark:text-white text-base font-bold bg-transparent transition-all"
          href="#contact"
        >
          Contact Me
        </a>
      </div>
      <div
        class="flex items-center gap-4 mt-4 text-sm text-gray-500 dark:text-gray-500"
      >
        <div class="flex -space-x-2">
          <div
            class="size-8 rounded-full bg-cover bg-center border-2 border-background-light dark:border-background-dark"
            data-alt="Portrait of a young professional woman"
            style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDdLHiL8_tzdy-CaJlMcP3t6h7xYNxvQDcfpDXdFKL4sXFFHL4s6Im9PeotuWp0QVL8XU-yqxUvd8i1bGx9nIugyW0Qn1Cy72NbSOZqbkVpMSfvFR-PLrUOaBV2L5xgcAEKpQokM-5CnlnN9rite2_tsdiVL-M6ZWGSPi9E_ENNA5UdI80C0zPjjToXtIBTlVxMTirprEW7drKSwLrpiYFm6eL7vIGq47Q0nzaf5V3moy0f7WRyix019HGpUX47SCC-uPq5qfz_Cs8");'
          >
          </div>
          <div
            class="size-8 rounded-full bg-cover bg-center border-2 border-background-light dark:border-background-dark"
            data-alt="Portrait of a man with glasses"
            style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBqc1rGnW25aRqCqVIUQwQghrRmnkrZE4Ejk0fjL6zgEyd4WvUQea96vr4rRIN5fJH_3bdmZ4Y2iDSAZdzV4AeXZVRZFntF_rXKvMlJGQdGP-SrzMm1llEfvd1Tr8fBGuiVVN-tmcb72iDC9aefOdPkRkgl4Lc23AUZ6d4yzx5isACSbApAFd8uwUqOEfkrf-xE4L1DCvpCsVC4CiheL4IwTj6dJrj0l68BpBn3cNq9FUTp8Bh57Am2JAZXyhenouvSSmmF0IJLy2I");'
          >
          </div>
          <div
            class="size-8 rounded-full bg-cover bg-center border-2 border-background-light dark:border-background-dark"
            data-alt="Portrait of a smiling man"
            style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBi4Ny-I04OxT-hTPvy13DqRGnieTzC1RGDQc1Z109SF-Kdv9qhsqjE5q_SCXIU5KVZGFsXgbbPUu46G_j5bA3iQ0YjPhrD-3i1OzVL8fRMSMh_9ugQofZlSiBR7RS8RQ6VPC_-M4ixpU_r89o-QM6t6dnHyJJ9gzDTGwns4EI6ua1-gSvN7nL6fTKvaqOc4NzHkalGDIU-s6bUwBOdERmutF8qfjIUhG9J61J88xELelNaH4K9iRWZiWQ3nx5UdLTRu9J8X-UEWvg");'
          >
          </div>
        </div>
        <span>Trusted by 50+ clients worldwide</span>
      </div>
    </div>
    <div class="lg:w-1/2 w-full">
      <div
        class="relative w-full aspect-square md:aspect-video lg:aspect-square bg-gradient-to-tr from-primary/20 via-background-dark to-background-dark rounded-2xl overflow-hidden shadow-2xl border border-gray-200 dark:border-gray-800"
      >
        <div
          class="absolute inset-0 bg-cover bg-center opacity-80 mix-blend-overlay"
          data-alt="Close up of computer code on a dark screen"
          style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuB90DrXFrGKi7jpaSgOgdZ_ZGjqiBsv8YS1aGwIe3PFeUHoNK8j40s9BtiBt--QFXddQqMEUHN9bILCIn6HYbx1Rdr_f3WO4m0Iz-usgwsiOcRXAcHw1i0asI54hDmHtvx_poLfXuRUfsHKVvcsMMOx3K90CTWG7lfvz0dIYn2s7GVKCOyIrZENggz3cyViPAO-E9gZThGabBIflA54K-pGx75e3LlxGPMkidTDRQaN2zWuFLmb-02Vn-PpWIhyWdOmI522qnXWMww");'
        >
        </div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div
            class="bg-surface-light/10 dark:bg-surface-dark/40 backdrop-blur-xl border border-white/10 p-6 rounded-xl shadow-2xl max-w-xs w-full transform rotate-3 hover:rotate-0 transition-transform duration-500"
          >
            <div class="flex items-center gap-3 mb-4">
              <div class="size-3 rounded-full bg-red-500"></div>
              <div class="size-3 rounded-full bg-yellow-500"></div>
              <div class="size-3 rounded-full bg-green-500"></div>
            </div>
            <div class="space-y-2">
              <div class="h-2 w-3/4 bg-gray-400/30 rounded"></div>
              <div class="h-2 w-1/2 bg-gray-400/30 rounded"></div>
              <div class="h-2 w-5/6 bg-gray-400/30 rounded"></div>
              <div class="h-2 w-full bg-primary/60 rounded mt-4"></div>
              <div class="h-2 w-2/3 bg-primary/60 rounded"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
