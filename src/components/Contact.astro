---

---

<section
  class="w-full bg-surface-light dark:bg-surface-dark border-t border-gray-200 dark:border-gray-800"
  id="contact"
>
  <div class="max-w-[1280px] px-4 md:px-10 py-16 md:py-24 mx-auto">
    <div class="flex flex-col lg:flex-row gap-16">
      <div class="lg:w-1/3">
        <h2 class="text-3xl font-bold tracking-tight mb-4">
          Let's build something together
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8">
          Have a project in mind? Looking to hire? Or just want to chat about
          tech? Drop me a message.
        </p>
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-4">
            <div
              class="size-10 rounded-full bg-background-light dark:bg-background-dark flex items-center justify-center text-primary"
            >
              <span class="material-symbols-outlined">mail</span>
            </div>
            <div>
              <p class="text-xs font-bold uppercase text-gray-500">Email</p>
              <p class="font-medium">hello@devportfolio.com</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div
              class="size-10 rounded-full bg-background-light dark:bg-background-dark flex items-center justify-center text-primary"
            >
              <span class="material-symbols-outlined">location_on</span>
            </div>
            <div>
              <p class="text-xs font-bold uppercase text-gray-500">Location</p>
              <p class="font-medium">San Francisco, CA</p>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:w-2/3">
        <form class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label
                class="text-sm font-medium text-gray-700 dark:text-gray-300"
                for="name">Name</label
              >
              <input
                class="w-full bg-background-light dark:bg-background-dark border border-gray-300 dark:border-gray-700 rounded-lg p-3 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                id="name"
                placeholder="John Doe"
                type="text"
              />
            </div>
            <div class="space-y-2">
              <label
                class="text-sm font-medium text-gray-700 dark:text-gray-300"
                for="email">Email</label
              >
              <input
                class="w-full bg-background-light dark:bg-background-dark border border-gray-300 dark:border-gray-700 rounded-lg p-3 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
                id="email"
                placeholder="john@example.com"
                type="email"
              />
            </div>
          </div>
          <div class="space-y-2">
            <label
              class="text-sm font-medium text-gray-700 dark:text-gray-300"
              for="subject">Subject</label
            >
            <select
              class="w-full bg-background-light dark:bg-background-dark border border-gray-300 dark:border-gray-700 rounded-lg p-3 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all"
              id="subject"
            >
              <option>Project Inquiry</option>
              <option>Job Opportunity</option>
              <option>General Question</option>
            </select>
          </div>
          <div class="space-y-2">
            <label
              class="text-sm font-medium text-gray-700 dark:text-gray-300"
              for="message">Message</label
            >
            <textarea
              class="w-full bg-background-light dark:bg-background-dark border border-gray-300 dark:border-gray-700 rounded-lg p-3 text-gray-900 dark:text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all resize-none"
              id="message"
              placeholder="Tell me about your project..."
              rows="5"></textarea>
          </div>
          <button
            class="bg-primary text-white font-bold py-3 px-8 rounded-lg hover:bg-blue-700 transition-colors w-full md:w-auto"
            type="button"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
