---
interface Props {
  createdAt: string;
  language: string | null;
  htmlUrl: string;
  homepageUrl: string | null;
  stars: number;
}

const { createdAt, language, htmlUrl, homepageUrl, stars } = Astro.props;

// Format the creation date
const createdDate = new Date(createdAt);
const formattedDate = createdDate.toLocaleDateString("es-ES", {
  month: "short",
  year: "numeric",
});

// Language color mapping - O(1) lookup
const LANGUAGE_COLORS: Record<string, string> = {
  typescript: "#3178C6",
  javascript: "#F7DF1E",
  python: "#3776AB",
  html: "#E34F26",
  astro: "#FF5D01",
  "jupyter notebook": "#DA5B0B",
};

const DEFAULT_COLOR = "#6B7280";

function getLanguageColor(lang: string | null): string {
  if (!lang) return DEFAULT_COLOR;
  return LANGUAGE_COLORS[lang.toLowerCase()] || DEFAULT_COLOR;
}
---

<div class="sticky top-24 space-y-6">
  <!-- Key Info Card -->
  <div
    class="bg-white dark:bg-surface-dark rounded-xl p-6 border border-gray-200 dark:border-[#282e39] shadow-sm"
  >
    <h3
      class="text-lg font-bold text-slate-900 dark:text-white mb-6 border-b border-gray-200 dark:border-[#282e39] pb-4"
    >
      Información del proyecto
    </h3>
    <div class="space-y-5">
      <div class="grid grid-cols-[24px_1fr] gap-3">
        <span
          class="material-symbols-outlined text-gray-400 dark:text-gray-500 text-[20px] mt-0.5"
          >business</span
        >
        <div>
          <p
            class="text-xs text-gray-500 uppercase tracking-wider font-semibold mb-1"
          >
            Tipo
          </p>
          <p class="text-slate-800 dark:text-white font-medium">
            Proyecto de código abierto
          </p>
        </div>
      </div>
      <div class="grid grid-cols-[24px_1fr] gap-3">
        <span
          class="material-symbols-outlined text-gray-400 dark:text-gray-500 text-[20px] mt-0.5"
          >person</span
        >
        <div>
          <p
            class="text-xs text-gray-500 uppercase tracking-wider font-semibold mb-1"
          >
            Rol
          </p>
          <p class="text-slate-800 dark:text-white font-medium">Desarrollador</p>
        </div>
      </div>
      <div class="grid grid-cols-[24px_1fr] gap-3">
        <span
          class="material-symbols-outlined text-gray-400 dark:text-gray-500 text-[20px] mt-0.5"
          >calendar_month</span
        >
        <div>
          <p
            class="text-xs text-gray-500 uppercase tracking-wider font-semibold mb-1"
          >
            Creado
          </p>
          <p class="text-slate-800 dark:text-white font-medium">
            {formattedDate}
          </p>
        </div>
      </div>
      <div class="grid grid-cols-[24px_1fr] gap-3">
        <span
          class="material-symbols-outlined text-gray-400 dark:text-gray-500 text-[20px] mt-0.5"
          >star</span
        >
        <div>
          <p
            class="text-xs text-gray-500 uppercase tracking-wider font-semibold mb-1"
          >
            Estrellas
          </p>
          <p class="text-slate-800 dark:text-white font-medium">
            {stars}
          </p>
        </div>
      </div>
    </div>
    <div class="mt-8 flex flex-col gap-3">
      {
        homepageUrl && (
          <a
            class="flex items-center justify-center gap-2 w-full bg-primary hover:bg-blue-600 text-white font-bold py-3 px-4 rounded-lg transition-all shadow-lg shadow-primary/20"
            href={homepageUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-[20px]">
              rocket_launch
            </span>
            Ver demo en vivo
          </a>
        )
      }
      <a
        class="flex items-center justify-center gap-2 w-full bg-transparent border border-gray-300 dark:border-[#282e39] hover:border-gray-400 dark:hover:border-gray-500 text-slate-700 dark:text-white font-semibold py-3 px-4 rounded-lg transition-all"
        href={htmlUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="material-symbols-outlined text-[20px]">code</span>
        Ver código
      </a>
    </div>
  </div>
  <!-- Tech Stack Card -->
  <div
    class="bg-white dark:bg-surface-dark rounded-xl p-6 border border-gray-200 dark:border-[#282e39] shadow-sm"
  >
    <h3 class="text-sm uppercase tracking-wider text-gray-500 font-bold mb-4">
      Tecnologías
    </h3>
    <div class="flex flex-wrap gap-2">
      {
        language && (
          <span class="px-3 py-1.5 rounded-full bg-slate-100 dark:bg-background-dark border border-gray-200 dark:border-[#282e39] text-slate-700 dark:text-gray-300 text-xs font-medium flex items-center gap-2">
            <span
              class="w-2 h-2 rounded-full"
              style={`background-color: ${getLanguageColor(language)}`}
            />
            {language}
          </span>
        )
      }
    </div>
  </div>
</div>
